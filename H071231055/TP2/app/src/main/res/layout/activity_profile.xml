<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/black">

                <!-- Sampul -->
                <ImageView
                    android:id="@+id/sampul"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:scaleType="centerCrop" />

                <!-- Foto Profil -->
                <FrameLayout
                    android:id="@+id/f3"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_alignBottom="@id/sampul"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="-48dp"
                    android:background="@drawable/lingkaran"
                    android:elevation="8dp"
                    android:scaleType="centerCrop">

                    <FrameLayout
                        android:id="@+id/f2"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:background="@drawable/lingkaran"
                        android:padding="3.5dp">

                        <ImageView
                            android:id="@+id/fotoprofil"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/lingkaran"
                            android:clipToOutline="true"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Layout untuk Tombol -->
                <LinearLayout
                    android:id="@+id/button_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/sampul"
                    android:layout_marginTop="10dp"
                    android:gravity="end"
                    android:orientation="horizontal"
                    android:paddingEnd="15dp">

                    <!-- Tombol Edit Profile -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/black"
                        android:text="Edit profile"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:cornerRadius="20dp"
                        app:strokeColor="#71767b"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#000000"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="6dp"
                android:paddingRight="16dp"
                android:paddingBottom="5dp">

                <!-- Layout untuk Data Umum -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Username -->
                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="_farafahirun_"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <!-- Icon Verified -->
                    <ImageView
                        android:id="@+id/icon_verified"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="Verified Badge"
                        android:src="@drawable/centangbiru" />

                    <!-- Get Verified -->
                    <TextView
                        android:id="@+id/get_verified"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Get Verified"
                        android:textColor="#3498db"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Nickname -->
                <TextView
                    android:id="@+id/tvNickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nickname_profile"
                    android:textColor="#71767b"
                    android:textSize="20sp" />

                <!-- Bio -->
                <TextView
                    android:id="@+id/tvBio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Layout untuk Data Private -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingBottom="5dp">

                <androidx.constraintlayout.helper.widget.Flow
                    android:id="@+id/flowGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="layoutLocation,layoutWebsite,layoutBirthDate, layoutJoining"
                    app:flow_horizontalAlign="start"
                    app:flow_horizontalGap="16dp"
                    app:flow_wrapMode="chain"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:ignore="MissingConstraints" />

                <!--                <LinearLayout-->
                <!--                    android:id="@+id/layoutInfo"-->
                <!--                    android:layout_width="match_parent"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:gravity="start"-->
                <!--                    android:orientation="vertical"-->
                <!--                    tools:ignore="MissingConstraints">-->

                <!-- Location Layout -->
                <LinearLayout
                    android:id="@+id/layoutLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/lokasi" />

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Location"
                        android:textColor="#71767b"
                        android:textSize="20sp" />
                </LinearLayout>

                <!-- Website Layout -->
                <LinearLayout
                    android:id="@+id/layoutWebsite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/link" />

                    <TextView
                        android:id="@+id/tvWebsite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Website"
                        android:textColor="#3498db"
                        android:textSize="20sp" />
                </LinearLayout>

                <!-- Birth Date Layout -->
                <LinearLayout
                    android:id="@+id/layoutBirthDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/balon" />

                    <TextView
                        android:id="@+id/tvBirthDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Birth Date"
                        android:textColor="#71767b"
                        android:textSize="20sp" />
                </LinearLayout>

                <!-- Joining Layout -->
                <LinearLayout
                    android:id="@+id/layoutJoining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    tools:ignore="MissingConstraints">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="bergabung"
                        android:src="@drawable/kalender" />

                    <TextView
                        android:id="@+id/tvJoining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#71767b"
                        android:textSize="20sp" />
                </LinearLayout>
                <!--                </LinearLayout>-->
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/black"
                android:orientation="vertical"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingBottom="5dp">

                <!-- Mengikuti & Pengikut -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <!-- Following -->
                    <TextView
                        android:id="@+id/tv_following"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" 4"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text=" Following"
                        android:textColor="#71767b"
                        android:textSize="18sp" />

                    <!-- Followers -->
                    <TextView
                        android:id="@+id/tv_followers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" 0"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Followers"
                        android:textColor="#71767b"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Layout untuk Tab -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#000000"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <!-- Tab Posts -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/tab_postingan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="8dp"
                            android:text="Posts"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="56dp"
                            android:layout_height="4dp"
                            android:background="@drawable/garis" />
                    </LinearLayout>

                    <!-- Tab Replies -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/tab_balasan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="8dp"
                            android:text="Replies"
                            android:textColor="#A6A6A6"
                            android:textSize="16sp" />

                        <View
                            android:layout_width="56dp"
                            android:layout_height="4dp"
                            android:background="@android:color/transparent" />
                    </LinearLayout>

                    <!-- Tab Highlights -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/tab_highlights"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="8dp"
                            android:text="Highlights"
                            android:textColor="#A6A6A6"
                            android:textSize="16sp" />

                        <View
                            android:layout_width="56dp"
                            android:layout_height="4dp"
                            android:background="@android:color/transparent" />
                    </LinearLayout>

                    <!-- Tab Articles -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/tab_articles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="8dp"
                            android:text="Articles"
                            android:textColor="#A6A6A6"
                            android:textSize="16sp" />

                        <View
                            android:layout_width="56dp"
                            android:layout_height="4dp"
                            android:background="@android:color/transparent" />
                    </LinearLayout>

                    <!-- Tab Media -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/tab_media"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="8dp"
                            android:text="Media"
                            android:textColor="#A6A6A6"
                            android:textSize="16sp" />

                        <View
                            android:layout_width="56dp"
                            android:layout_height="4dp"
                            android:background="@android:color/transparent" />
                    </LinearLayout>

                    <!-- Tab Likes -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/tab_likes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="8dp"
                            android:text="Likes"
                            android:textColor="#A6A6A6"
                            android:textSize="16sp" />

                        <View
                            android:layout_width="56dp"
                            android:layout_height="4dp"
                            android:background="@android:color/transparent" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="2dp"
                android:background="#333333" />

            <!-- Who to Follow -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#000000"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/who_follow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10dp"
                    android:paddingBottom="8dp"
                    android:text="Who to follow"
                    android:textColor="#ffffff"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#000000"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="4dp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Tampilkan lebih banyak -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#000000"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/tampilan_banyak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10dp"
                    android:paddingBottom="8dp"
                    android:text="Tampilkan lebih banyak"
                    android:textColor="#3498db"
                    android:textSize="16sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="2dp"
                android:background="#333333" />

            <!-- Titik -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#000000"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="•"
                    android:textColor="#71767b"
                    android:textSize="14sp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Layout untuk Tombol -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:weightSum="1"
        tools:ignore="MissingConstraints">

        <!-- Kiri -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start">

            <!-- Kembali -->
            <ImageView
                android:id="@+id/kembali"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:src="@drawable/kembali" />
        </LinearLayout>

        <!-- Kanan -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end">

            <!-- Grok -->
            <ImageView
                android:id="@+id/grok"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:src="@drawable/grok" />

            <!-- Telusuri -->
            <ImageView
                android:id="@+id/telusuri"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:src="@drawable/telusuri" />

            <!-- Menu -->
            <ImageView
                android:id="@+id/menuP"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:src="@drawable/menu2" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tombol Tambah -->
    <ImageView
        android:id="@+id/tambah"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:padding="10dp"
        android:scaleType="centerCrop"
        android:src="@drawable/tambah"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>